# ==========================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — it contains secrets.
# ==========================================================

# ==========================================================
# General
# ==========================================================
# development | production | test
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info

# ==========================================================
# Database — MongoDB Atlas (see docs/mongodb-atlas-setup.md)
# Keep /fleet_db as the database name.
# ==========================================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/fleet_db?retryWrites=true&w=majority

# ==========================================================
# Authentication (Phase 3)
# ==========================================================
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=1h

# ==========================================================
# API Gateway
# ==========================================================
# Comma-separated list of valid API keys (dev key below is for local use only)
API_KEYS=fleet-dev-key-123
# Requests allowed per API key per window (900000 ms = 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# How long the gateway waits for a service before answering 504
PROXY_TIMEOUT_MS=10000

# ==========================================================
# Service URLs (Docker Compose service names; defaults shown)
# ==========================================================
USER_SERVICE_URL=http://user-service:3001
VEHICLE_SERVICE_URL=http://vehicle-service:3002
TELEMETRY_SERVICE_URL=http://telemetry-service:3003
MAPS_SERVICE_URL=http://maps-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# ==========================================================
# Service-to-service authentication (Phase 5)
# ==========================================================
# INTERNAL_SERVICE_TOKEN=change-me

# ==========================================================
# Geolocation — OpenStreetMap Nominatim (Phase 7)
# ==========================================================
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=fleet-management-system/1.0 (student project)

# ==========================================================
# SMS notifications (Phase 5)
# ==========================================================
# mock | twilio
# SMS_PROVIDER=mock
