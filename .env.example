# ==========================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — it contains secrets.
# ==========================================================

# ==========================================================
# General
# ==========================================================
# development | production | test
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info

# ==========================================================
# Database — MongoDB Atlas (see docs/mongodb-atlas-setup.md)
# Keep /fleet_db as the database name.
# ==========================================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/fleet_db?retryWrites=true&w=majority

# ==========================================================
# Authentication (JWT + password hashing)
# ==========================================================
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Token lifetime, e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=1h
# bcrypt cost factor (higher = slower = harder to brute-force)
BCRYPT_ROUNDS=10

# ==========================================================
# Bootstrap admin — created by user-service on first start if no admin exists.
# Change these before the first start; they are NOT applied to an existing admin.
# ==========================================================
ADMIN_NAME=Fleet Admin
ADMIN_EMAIL=admin@fleet.dev
ADMIN_PASSWORD=Admin@12345
# International (E.164) format; receives SMS alerts
ADMIN_PHONE=+919000000001

# ==========================================================
# API Gateway
# ==========================================================
# Comma-separated list of valid API keys (dev key below is for local use only)
API_KEYS=fleet-dev-key-123
# Requests allowed per API key per window (900000 ms = 15 min)
RATE_LIMIT_WINDOW_MS=900000
# The dashboard refreshes every 15 s (only while its tab is visible); for a long demo use e.g. 1000
RATE_LIMIT_MAX=100
# How long the gateway waits for a service before answering 504
PROXY_TIMEOUT_MS=10000

# ==========================================================
# Service URLs (Docker Compose service names; defaults shown)
# ==========================================================
USER_SERVICE_URL=http://user-service:3001
VEHICLE_SERVICE_URL=http://vehicle-service:3002
TELEMETRY_SERVICE_URL=http://telemetry-service:3003
MAPS_SERVICE_URL=http://maps-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# ==========================================================
# Service-to-service authentication
# ==========================================================
# Shared secret that services send to each other's /internal endpoints (x-internal-token).
# At least 32 characters. Generate one with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-another-long-random-string-32-chars
# How long a service waits for notification-service before giving up (ms)
NOTIFY_TIMEOUT_MS=3000

# ==========================================================
# Geolocation — OpenStreetMap Nominatim (Phase 7)
# ==========================================================
# Free, no API key. Usage policy: identify the app (User-Agent), max 1 request/second, cache results.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fleet-management-system/1.0
# How long maps-service waits for Nominatim per attempt (ms); a timeout is retried once
GEOCODER_TIMEOUT_MS=4000
# Only search in these countries (comma-separated ISO codes; empty = worldwide)
GEOCODER_COUNTRY_CODES=in

# ==========================================================
# SMS notifications
# ==========================================================
# mock = log the SMS instead of sending it (numbers ending in 0000 fail on purpose)
SMS_PROVIDER=mock

# ==========================================================
# Telemetry
# ==========================================================
# Minimum time between two SMS alerts for the same vehicle and event (300000 ms = 5 min)
ALERT_COOLDOWN_MS=300000

# ==========================================================
# Telemetry simulator (docker compose --profile tools run --rm simulate)
# ==========================================================
# Time between readings, number of rounds (0 = until Ctrl+C), low-battery alerts on/off,
# and how much faster than real time the vehicles move (so they visibly move on the map)
SIM_INTERVAL_MS=5000
SIM_TICKS=0
SIM_ALERT=true
SIM_SPEEDUP=10
