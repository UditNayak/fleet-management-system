    {
      "name": "Users",
      "description": "Registration, login (JWT), profile and admin user management.\n\nRun **Login as admin** first: it stores the token in `adminToken`. **Register driver** + **Login as driver** store `driverToken`.",
      "item": [
        {
          "name": "Register driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Creates a driver with a unique email (generated in the pre-request script).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"phone\": \"+919876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('driverEmail', `driver${Date.now()}@fleet.dev`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Role is driver', () => pm.expect(pm.response.json().user.role).to.eql('driver'));",
                  "pm.test('No password in response', () => pm.expect(pm.response.json().user).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('driverId', pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email \u2192 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Same email as the previous request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
